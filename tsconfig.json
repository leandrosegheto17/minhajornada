{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom/vitest"],
    "noEmit": true
  },
  "include": ["src", "test", "e2e", "scripts", "vite.config.ts", "playwright.config.ts", "eslint.config.mjs"],
  "exclude": ["src/pwa/sw.ts"]
}
