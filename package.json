{
  "name": "minhajornada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "resumos:publicar": "node scripts/resumos/publicar.ts",
    "criar-dono": "node scripts/criar-dono.ts",
    "migrar": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m servidor/migracoes --database-url-var DATABASE_URL_DONO --no-single-transaction",
    "converter-biblia": "node scripts/converter-biblia.ts",
    "predev": "node scripts/converter-biblia.ts",
    "dev": "vite",
    "prebuild": "node scripts/converter-biblia.ts",
    "build": "vite build",
    "revisao:montar": "vite build --config revisao/vite.config.ts",
    "revisao-resumos:montar": "vite build --config revisao-resumos/vite.config.ts",
    "build:e2e": "node scripts/converter-biblia.ts --correcoes test/arquivos/dados/correcoes-exemplo.json && vite build --outDir dist-e2e",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "pretypecheck": "node scripts/converter-biblia.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.servidor.json",
    "pretest": "node scripts/converter-biblia.ts",
    "test": "vitest run --reporter=dot",
    "e2e": "playwright test --reporter=dot"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "4.162.0"
  },
  "packageManager": "pnpm@11.23.0"
}
